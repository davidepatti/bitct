# Change GROUP to your group code (letters, digits, '-'); use the same value in the Wokwi sketch.
GROUP=g00-change-me
# Public MQTT broker reachable by Wokwi's virtual Wi-Fi
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
# Seconds between Merkle batches, and between regtest blocks
BATCH_SECONDS=60
MINER_INTERVAL=30
